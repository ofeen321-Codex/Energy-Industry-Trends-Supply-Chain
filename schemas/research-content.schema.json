{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:energy-supply-chain:research-content:v1",
  "title": "Energy research content bundle",
  "type": "object",
  "required": ["observations", "outlooks", "releases"],
  "additionalProperties": false,
  "properties": {
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "outlooks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outlook"}},
    "releases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/release"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "date": {"type": "string", "format": "date"},
    "sourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[SADB][0-9]+$"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "claim_type", "text", "source_ids", "geography", "period", "metric", "limitation", "evidence_confidence", "last_reviewed"],
      "properties": {
        "id": {"type": "string", "pattern": "^E[0-9]+$"},
        "claim_type": {"enum": ["reported_observation", "documented_provision", "source_forecast", "source_analysis"]},
        "text": {"$ref": "#/$defs/text"}, "source_ids": {"$ref": "#/$defs/sourceIds"},
        "geography": {"$ref": "#/$defs/text"}, "period": {"$ref": "#/$defs/text"},
        "metric": {"$ref": "#/$defs/text"}, "limitation": {"$ref": "#/$defs/text"},
        "evidence_confidence": {"$ref": "#/$defs/confidence"}, "last_reviewed": {"$ref": "#/$defs/date"}
      }
    },
    "outlook": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "topic", "claim_type", "status", "as_of", "horizon_start", "horizon_end", "global_view", "us_view", "observation_ids", "source_ids", "confidence", "procurement_actions", "review_triggers", "counterevidence", "evaluation", "last_reviewed", "next_review_due"],
      "properties": {
        "id": {"type": "string", "pattern": "^F[0-9]+$"},
        "title": {"$ref": "#/$defs/text"}, "topic": {"$ref": "#/$defs/text"},
        "claim_type": {"enum": ["analyst_outlook", "source_forecast", "scenario"]},
        "status": {"enum": ["draft", "approved", "superseded", "withdrawn"]},
        "as_of": {"$ref": "#/$defs/date"}, "horizon_start": {"$ref": "#/$defs/date"}, "horizon_end": {"$ref": "#/$defs/date"},
        "global_view": {"$ref": "#/$defs/text"}, "us_view": {"$ref": "#/$defs/text"},
        "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E[0-9]+$"}},
        "source_ids": {"$ref": "#/$defs/sourceIds"}, "confidence": {"$ref": "#/$defs/confidence"},
        "procurement_actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "review_triggers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "counterevidence": {"$ref": "#/$defs/text"},
        "evaluation": {"type": "object", "additionalProperties": false, "required": ["method", "criterion"], "properties": {"method": {"const": "directional_review"}, "criterion": {"$ref": "#/$defs/text"}}},
        "last_reviewed": {"$ref": "#/$defs/date"}, "next_review_due": {"$ref": "#/$defs/date"},
        "approved_by": {"$ref": "#/$defs/text"}, "approved_at": {"type": "string", "format": "date-time"}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "as_of", "summary", "report_path", "changes"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "status": {"enum": ["draft", "archived_draft", "approved", "published"]},
        "as_of": {"$ref": "#/$defs/date"}, "summary": {"$ref": "#/$defs/text"}, "report_path": {"$ref": "#/$defs/text"},
        "changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "approved_by": {"$ref": "#/$defs/text"}, "approved_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
